# Copy to .env and set your deployment URLs
# VITE_ variables are embedded in the JS bundle at build time
VITE_API_URL=https://yourdomain.com/api
VITE_ENGINE_URL=https://yourdomain.com/ai
VITE_ENGINE_API_KEY=          # same value as AI_ENGINE_API_KEY in backend/.env
VITE_PAYPAL_CLIENT_ID=        # PayPal client ID (sandbox or live)
