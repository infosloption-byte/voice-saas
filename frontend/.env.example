# Copy to .env and set your deployment URLs
# VITE_ variables are embedded in the JS bundle at build time — never put
# secrets here. The engine API key is NOT a frontend variable anymore; the
# backend holds it and proxies all engine calls under /api/engine/*.
VITE_API_URL=https://yourdomain.com/api
# Only used by a legacy fallback; point it at the backend engine proxy.
VITE_ENGINE_URL=https://yourdomain.com/api/engine
VITE_PAYPAL_CLIENT_ID=        # PayPal client ID (sandbox or live)
VITE_GOOGLE_CLIENT_ID=        # Google OAuth client ID (Sign in with Google)
