APP_NAME=Laravel
APP_ENV=local
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_URL=http://localhost
APP_DOMAIN=localhost              # PRODUCTION: set to yourdomain.com (used by trustHosts)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # PRODUCTION: error | LOCAL: debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false       # PRODUCTION: true  (HTTPS only)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (SMTP) ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org           # or smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=                       # SMTP username / API key
MAIL_PASSWORD=                       # SMTP password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

# ── AI Engine ─────────────────────────────────────────────────────────
AI_ENGINE_URL=http://127.0.0.1:8000
AI_ENGINE_API_KEY=                # generate a long random secret; set same value in engine .env

# ── PayPal ────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=                    # from PayPal developer dashboard
PAYPAL_SECRET=                       # from PayPal developer dashboard
PAYPAL_MODE=sandbox                  # PRODUCTION: live
PAYPAL_PLAN_STARTER=                 # PayPal subscription plan ID for Starter
PAYPAL_PLAN_PRO=                     # PayPal subscription plan ID for Pro
PAYPAL_WEBHOOK_ID=                   # from PayPal webhook settings
FRONTEND_URL=http://localhost:5173   # PRODUCTION: https://yourdomain.com

VITE_APP_NAME="${APP_NAME}"
