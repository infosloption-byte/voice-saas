# Copy to .env and fill in values before running docker-compose
# NEVER commit .env to version control

# MySQL
DB_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# Backend
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# Sanctum stateful domains — comma-separated
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# ── Frontend build-time variables (baked into the JS bundle) ────────
# These are passed as Docker build args when running: docker compose build frontend
VITE_API_URL=https://yourdomain.com/api
VITE_ENGINE_URL=https://yourdomain.com/ai
VITE_ENGINE_API_KEY=           # must match AI_ENGINE_API_KEY in backend/.env
VITE_ADMIN_EMAIL=              # your admin email — unlocks the AI Engines panel in Settings
ADMIN_EMAIL=                   # same email — used by backend AdminOnly middleware

# ── Audio storage ──────────────────────────────────────────────────────
# Default: local disk (storage/app/audio inside the container).
# Set AUDIO_DISK=s3 and fill AWS_* to migrate to S3 — no code changes needed.
AUDIO_DISK=local
AUDIO_PRUNE_DAYS=90            # delete audio files older than this many days

# AWS S3 (leave blank until you provision a bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1   # e.g. eu-west-1, ap-southeast-1
AWS_BUCKET=                    # e.g. voxora-audio

# PayPal — get from https://developer.paypal.com/developer/applications
VITE_PAYPAL_CLIENT_ID=         # the Client ID from your PayPal app
VITE_PAYPAL_PLAN_STARTER=      # Plan ID for Starter plan (P-xxx...)
VITE_PAYPAL_PLAN_PRO=          # Plan ID for Pro plan (P-xxx...)

# ── Backend PayPal credentials (runtime, not baked into bundle) ──────
# These go in backend/.env on the server (or add to backend environment in docker-compose)
# PAYPAL_CLIENT_ID=            # same Client ID as above
# PAYPAL_SECRET=               # Secret from your PayPal app
# PAYPAL_MODE=sandbox          # 'sandbox' for testing, 'live' for production
# PAYPAL_PLAN_STARTER=         # Plan ID from PayPal (P-xxx...)
# PAYPAL_PLAN_PRO=             # Plan ID from PayPal (P-xxx...)
# PAYPAL_WEBHOOK_ID=           # Webhook ID after creating webhook in PayPal dashboard

# ── AI Translation key (used by the ai-engine container) ─────────────
# Required for the Translate feature. The engine tries several Gemini
# models in order, falling over to the next if one is rate-limited.
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
